@model RegisterViewModel
@{ ViewData["Title"] = "Join CineScope"; }
<div class="auth-wrap"><div class="auth-card"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">C</span> CineScope</a><div class="eyebrow text-accent mt-4">YOUR MOVIE COMMUNITY</div><h1>Find your people.</h1><p class="muted">Join to rate, review, and keep a watchlist.</p>
<form asp-action="Register" method="post"><input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]"/><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-control mb-3" autocomplete="nickname"/><span asp-validation-for="DisplayName" class="text-danger"></span><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3" autocomplete="email"/><span asp-validation-for="Email" class="text-danger"></span><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control mb-3" autocomplete="new-password"/><span asp-validation-for="Password" class="text-danger"></span><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control mb-3" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span><button class="btn btn-accent w-100 mt-2">Create account</button></form><p class="auth-switch">Already a member? <a asp-action="Login">Sign in</a></p></div></div>
