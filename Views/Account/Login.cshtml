@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<div class="auth-wrap"><div class="auth-card"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">C</span> CineScope</a><div class="eyebrow text-accent mt-4">WELCOME BACK</div><h1>Good to see you.</h1><p class="muted">Sign in to rate, review, and save films.</p>
<form asp-action="Login" method="post"><input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]"/><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3" autocomplete="email"/><span asp-validation-for="Email" class="text-danger"></span><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password"/><span asp-validation-for="Password" class="text-danger"></span><div class="form-check my-3"><input asp-for="RememberMe" class="form-check-input"/><label asp-for="RememberMe" class="form-check-label"></label></div><button class="btn btn-accent w-100">Sign in</button></form><p class="auth-switch">New to CineScope? <a asp-action="Register">Create an account</a></p></div></div>
