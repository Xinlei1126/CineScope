@model IReadOnlyList<ApplicationUser>
@{ ViewData["Title"] = "User management"; }
<div class="container page-shell"><div class="section-heading"><div><div class="eyebrow text-accent">ADMINISTRATION</div><h2>Members</h2><p>@Model.Count registered accounts</p></div></div><div class="admin-nav"><a asp-action="Index">Movies</a><a asp-action="Reviews">Reviews</a><a class="active" asp-action="Users">Users</a></div><div class="table-responsive admin-table"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Account status</th><th>Email verified</th><th></th></tr></thead><tbody>@foreach(var user in Model){<tr><td>@user.DisplayName</td><td>@user.Email</td><td>@(user.LockoutEnd > DateTimeOffset.UtcNow ? "Locked" : "Active")</td><td>@(user.EmailConfirmed ? "Yes" : "No")</td><td class="text-end"><form asp-action="ToggleUserLockout" method="post"><input type="hidden" name="id" value="@user.Id"/><button class="btn btn-sm @(user.LockoutEnd > DateTimeOffset.UtcNow ? "btn-outline-success" : "btn-outline-danger")">@(user.LockoutEnd > DateTimeOffset.UtcNow ? "Unlock" : "Lock")</button></form></td></tr>}</tbody></table></div></div>
