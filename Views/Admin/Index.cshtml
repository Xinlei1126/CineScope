@model IReadOnlyList<Movie>
@{ ViewData["Title"] = "Movie management"; }
<div class="container page-shell"><div class="section-heading"><div><div class="eyebrow text-accent">ADMINISTRATION</div><h2>Movie catalog</h2><p>Create and maintain the collection.</p></div><a asp-action="Create" class="btn btn-accent">＋ Add movie</a></div><div class="admin-nav"><a class="active" asp-action="Index">Movies</a><a asp-action="Reviews">Reviews</a><a asp-action="Users">Users</a></div>
<div class="table-responsive admin-table"><table class="table"><thead><tr><th>Title</th><th>Genre</th><th>Year</th><th>Rating</th><th></th></tr></thead><tbody>@foreach(var movie in Model){<tr><td><a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id">@movie.Title</a></td><td>@movie.Genre</td><td>@movie.ReleaseYear</td><td>★ @movie.Rating.ToString("0.0")</td><td class="text-end"><a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-sm btn-outline-light">Edit</a> <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr>}</tbody></table></div></div>
