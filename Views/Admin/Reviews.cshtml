@model IReadOnlyList<MovieReview>
@{ ViewData["Title"] = "Review moderation"; }
<div class="container page-shell"><div class="section-heading"><div><div class="eyebrow text-accent">ADMINISTRATION</div><h2>Review moderation</h2><p>Hide or remove community reviews.</p></div></div><div class="admin-nav"><a asp-action="Index">Movies</a><a class="active" asp-action="Reviews">Reviews</a><a asp-action="Users">Users</a></div>
@if(Model.Count == 0){<div class="empty-state"><h3>No reviews yet</h3></div>} @foreach(var r in Model){<article class="review-card admin-review"><div class="review-avatar">@((r.User.DisplayName ?? r.User.Email ?? "M").Substring(0,1).ToUpperInvariant())</div><div class="review-content"><div class="review-top"><strong>@r.Movie.Title · @(r.User.DisplayName ?? r.User.Email)</strong><span class="gold">★ @r.Rating/10</span></div><small class="muted">@r.CreatedAt.ToLocalTime().ToString("MMM d, yyyy") · @(r.IsApproved ? "Visible" : "Hidden")</small><p>@r.Body</p><div class="d-flex gap-2"><form asp-action="ModerateReview" method="post"><input type="hidden" name="id" value="@r.Id"/><button class="btn btn-sm btn-outline-light">@(r.IsApproved ? "Hide" : "Approve")</button></form><form asp-action="DeleteReview" method="post"><input type="hidden" name="id" value="@r.Id"/><button class="btn btn-sm btn-outline-danger">Remove</button></form></div></div></article>}</div>
