<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — CineScope</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar"><nav class="navbar navbar-expand-lg container"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">C</span> CineScope</a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="nav"><form class="nav-search" asp-controller="Home" asp-action="Index" method="get"><span>⌕</span><input name="search" value="@Context.Request.Query["search"]" placeholder="Search movies" aria-label="Search movies" /></form>
<div class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
<a class="nav-link" asp-controller="Home" asp-action="Index">Discover</a>
@if (User.Identity?.IsAuthenticated == true) { <a class="nav-link" asp-controller="Movies" asp-action="Favorites">My list</a> }
@if (User.IsInRole("Admin")) { <a class="nav-link" asp-controller="Admin" asp-action="Index">Manage</a> }
@if (User.Identity?.IsAuthenticated == true) { <span class="nav-user">Hi, @(User.Identity.Name?.Split('@')[0])</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Sign out</button></form> }
else { <a asp-controller="Account" asp-action="Login" class="nav-link">Sign in</a><a asp-controller="Account" asp-action="Register" class="btn btn-accent btn-sm">Join free</a> }
</div></div></nav></header>
<main>@RenderBody()</main>
<footer class="footer"><div class="container d-flex justify-content-between flex-wrap gap-2"><span>© @DateTime.UtcNow.Year CineScope</span><span>Find your next favorite.</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>document.querySelectorAll('.poster-img').forEach(i=>i.addEventListener('error',()=>{i.style.display='none';i.parentElement.classList.add('poster-fallback')}));</script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
